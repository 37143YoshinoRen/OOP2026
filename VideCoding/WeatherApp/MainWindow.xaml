<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気アプリ"
        Height="452"
        Width="1097">

    <Grid Margin="-250,0,10,0">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0F24" Offset="0"/>
                <GradientStop Color="#152850" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="320"
            Padding="20"
            CornerRadius="20"
            Background="#22FFFFFF"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="WEATHER SYSTEM"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#00E5FF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <TextBox x:Name="CityTextBox"
                     Height="35"
                     FontSize="14"
                     Background="#30FFFFFF"
                     Foreground="White"
                     BorderBrush="#00E5FF"
                     Text="Tokyo"
                     Margin="0,0,0,15"/>

                <Button x:Name="SearchButton"
                    Content="取得"
                    Height="40"
                    Click="SearchButton_Click"
                    Background="#00E5FF"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Margin="0,0,0,20"/>

                <Border Background="#15FFFFFF"
                    CornerRadius="15"
                    Padding="15">

                    <StackPanel>
                        <TextBlock
                                x:Name="BigWeatherText"
                                Text="☀️"
                                FontSize="80"
                                HorizontalAlignment="Center"/>

                        <TextBlock
                                x:Name="TempTextBlock"
                                Text="18.5℃"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="#00E5FF"
                                HorizontalAlignment="Center"/>

                        <TextBlock
                                x:Name="WeatherTextBlock"
                                Text="晴れ"
                                FontSize="24"
                                Foreground="White"
                                HorizontalAlignment="Center"/>

                        <TextBlock
                                x:Name="HumidityTextBlock"
                                Text="湿度 62%"
                                FontSize="18"
                                Foreground="#64FFDA"
                                HorizontalAlignment="Center"/>

                        <ItemsControl x:Name="ForecastList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                </Border>

            </StackPanel>

        </Border>
    </Grid>

</Window>
