@using SelfOrderSystem.Models
@model List<Order>

@{
    ViewData["Title"] = "店舗 注文管理";

    int activeCount = Model.Count(o => o.Status != OrderStatus.Served);
    int servedCount = Model.Count(o => o.Status == OrderStatus.Served);
}

<div class="staff-page">

    <link rel="stylesheet"
          href="~/css/staff.css"
          asp-append-version="true" />

    <div class="staff-header">
        <div>
            <p class="staff-eyebrow">STAFF DASHBOARD</p>
            <h1>店舗 注文管理</h1>
            <p>新しい注文から最大50件を表示しています</p>
        </div>

        <span class="staff-header-label">
            ORDER MANAGEMENT
        </span>
    </div>

    <div class="staff-summary">

        <div class="staff-summary-box">
            <span>表示件数</span>
            <strong>@Model.Count</strong>
        </div>

        <div class="staff-summary-box">
            <span>対応中</span>
            <strong>@activeCount</strong>
        </div>

        <div class="staff-summary-box">
            <span>提供済み</span>
            <strong>@servedCount</strong>
        </div>

    </div>

    @if(Model.Count == 0) {
        <div class="staff-empty">
            <h2>現在、注文はありません</h2>
            <p>新しい注文が入ると、ここに表示されます</p>
        </div>
    } else {
        <div class="staff-order-grid">

            @foreach(var order in Model) {
                var total = order.Items.Sum(i => i.UnitPrice * i.Quantity);

                <article class="staff-order-card">

                    <div class="staff-order-top">

                        <div class="staff-order-identity">

                            <span class="staff-table-number">
                                卓 @order.TableNumber
                            </span>

                            <div>

                                <div class="staff-order-id">
                                    注文 #@order.Id
                                </div>

                                <time class="staff-order-time">
                                    @(order.OrderedAtUtc
                                                                .ToLocalTime()
                                                                .ToString("yyyy/MM/dd HH:mm"))
                                                                                          </time>

                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <span class="staff-status
                                        @(order.Status == OrderStatus.Served
                                                                  ? "staff-status-served"
                                                                  : order.Status == OrderStatus.Cooking
                                                                  ? "staff-status-cooking"
                                                                  : "staff-status-new")">

                        @order.Status.ToJapanese()

                            </span>

                            <button type="button"
                                    class="staff-toggle-button"
                                    onclick="toggleOrder(this)">
                                開く
                            </button>

                        </div>

                    </div>

                    <div class="staff-order-details">

                        <div class="staff-order-items">

                    @foreach(var item in order.Items) {
                                <div class="staff-order-item">

                                    <span>
                                        @item.Product?.Name
                                    </span>

                                    <strong>
                                        × @item.Quantity
                                    </strong>

                                </div>
                            }

                        </div>

                        <div class="staff-order-bottom">

                            <div class="staff-total">

                                <span>注文合計</span>

                                <strong>
                                    @total.ToString("N0")
                                </strong>

                            </div>

                            @if(order.Status != OrderStatus.Served) {
                                <form asp-controller="Staff"
                                      asp-action="Advance"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@order.Id" />

                                    <button type="submit"
                                            class="btn staff-action-button">

                                        @order.Status.NextActionLabel()
                                        →

                                    </button>

                                </form>
                            } else {
                                <span class="staff-completed">
                                    完了
                                </span>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>

<script>
    function toggleOrder(button) {

        const details =
            button.closest('.staff-order-card')
                  .querySelector('.staff-order-details');

        details.classList.toggle('open');

        if (details.classList.contains('open')) {
            button.textContent = '閉じる';
        }
        else {
            button.textContent = '開く';
        }
    }
</script>

@section Scripts {
    @* LibMan で追加したSignalRのJavaScript *@ 
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <script>

        // Hubとの接続を作る
        const staffConnection = new signalR.HubConnectionBuilder()
        .withUrl("/staffOrdersHub")
        .withAutomaticReconnect()
        .build();
        // 通知を受けたら最新の注文一覧を読み直す
        staffConnection.on("OrdersChanged", () => {
        window.location.reload();
        });
        // 再接続後も表示内容を更新する
        staffConnection.onreconnected(() => window.location.reload());
        staffConnection.start().catch(error => {
        console.error("店舗 SignalR 接続エラー", error);
        });
    </script>
}